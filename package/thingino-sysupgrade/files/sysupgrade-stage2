#!/tmp/busybox sh

export PATH="/tmp/sysupgrade"
echo "stage 2 PATH is $PATH"

echo_c() {
	echo -e "\e[38;5;$1m$2\e[0m"
}

die() {
	echo_c 160 "$1"
	exit 1
}

# Byte offset where the data (config) partition starts = sum of the sizes of the
# real partitions before it ("all" pseudo-partition skipped). Pure shell so it
# works from the /tmp/sysupgrade PATH after the rootfs is gone.
_data_offset() {
	local d s e n off=0
	while read -r d s e n; do
		case "$d" in mtd*) : ;; *) continue ;; esac
		n="${n%\"}"; n="${n#\"}"
		case "$n" in
			data) echo "$off"; return 0 ;;
			all) : ;;
			*) off=$((off + 0x$s)) ;;
		esac
	done < /proc/mtd
	echo 0
}

flash_firmware() {
	echo_c 112 "\nFlashing firmware to $mtd_dev"
	# Cinnado S2 / ATBM6441: the data (config) partition (/overlay = mtd4, jffs2 -
	# holds WiFi creds + settings) is the top of the "all" image. A plain
	# flash_eraseall+flashcp of the whole 16MB wipes it, so the camera comes up in
	# AP mode after every OTA and you lose contact with it. Instead, when the image
	# reaches into the data partition (a full "all" image), truncate it in place to
	# just before data and flashcp WITHOUT flash_eraseall - flashcp erases only the
	# region it writes, so boot+env+kernel+rootfs update and data (config) stays
	# intact. _data_offset is pure shell (no external tools) so it can't silently
	# fail into the erase-everything path. A smaller image (bootloader/kernel-only)
	# does not reach data, so the full erase is safe there.
	local data_off fw_size
	data_off="$(_data_offset)"
	fw_size="$(stat -c%s "$fw_file" 2>/dev/null || echo 0)"
	if [ "${data_off:-0}" -gt 0 ] && [ "${fw_size:-0}" -gt "$data_off" ]; then
		echo_c 112 "Preserving data/config partition (data starts at $data_off): flashing 0..$data_off only"
		truncate -s "$data_off" "$fw_file" || die "truncate failed - refusing to erase config"
		flashcp -v "$fw_file" "$mtd_dev"
	else
		flash_eraseall "$mtd_dev"
		flashcp -v "$fw_file" "$mtd_dev"
	fi
}

stop_streamer() {
	echo_c 112 "\nStopping streamer in detached stage"
	if [ -x /etc/init.d/S31raptor ]; then
		/etc/init.d/S31raptor stop
	elif [ -x /etc/init.d/S31prudynt ]; then
		/etc/init.d/S31prudynt stop
	else
		killall prudynt 2>/dev/null || true
		sleep 1
		pidof prudynt >/dev/null 2>&1 && killall -9 prudynt 2>/dev/null || true
	fi
	sleep 1
}

stream_flash_progress() {
	local logfile="$1"
	local pid="$2"
	local tail_pid=""

	if command -v tail >/dev/null 2>&1; then
		tail -n 20 -f "$logfile" &
		tail_pid=$!
	else
		echo "tail not available in PATH, monitor $logfile manually."
	fi

	wait "$pid"
	local status=$?

	if [ -n "$tail_pid" ]; then
		kill "$tail_pid" 2>/dev/null
		wait "$tail_pid" 2>/dev/null
	fi

	echo ""
	return $status
}

# Detach from terminal and protect against disconnections during flash
detach_and_flash() {
	logfile="/tmp/sysupgrade-flash.log"
	: >"$logfile"

	echo_c 208 "CRITICAL PHASE: Detaching from terminal to protect against connection loss..."
	echo "Process will continue even if SSH disconnects."
	echo "Log file: $logfile"
	echo ""

	# Run in subshell detached from terminal
	(
		# Protect against all signals during flash
		trap '' HUP INT TERM

		exec >$logfile 2>&1

		echo "=== Flash operation started at $(date) ==="
		stop_streamer

		MAX_TRIES=3
		x=0
		times=""
		while :; do
			x=$((x+1))
			if flash_firmware; then
				echo "=== Flash completed successfully at $(date) ==="
				go_reboot
				exit 1
			fi
			[ $x -gt 1 ] && times=" $x times"
			echo "Flashing failed${times}."
			[ $x -gt $MAX_TRIES ] && break
			echo "Retrying in 5 seconds..."
			sleep 5
		done
		echo "Flashing failed after $MAX_TRIES attempts!"
		echo "WARNING: You may need to perform a recovery flash restore before rebooting the camera!"
		exit 1
	) </dev/null &

	flash_pid=$!
	echo "Flash process running with PID $flash_pid (safe to disconnect)"
	echo "Streaming flash progress (Ctrl-C stops viewing, flashing continues)..."

	stream_flash_progress "$logfile" "$flash_pid"
	flash_status=$?

	if [ $flash_status -eq 0 ]; then
		echo_c 46 "Flash completed successfully. Rebooting shortly..."
		echo "Rebooting"
	else
		echo_c 160 "Flash failed; consult $logfile for details."
	fi

	exit $flash_status
}

go_reboot() {
	echo "Rebooting in 5 seconds..."
	sleep 5
	sync
	# Cinnado S2 / ATBM6441: a T23-only reset (echo wdt / reboot -f) leaves the
	# ATBM WiFi core stale, so WiFi is dead after an OTA and the boot can hang.
	# Arm the MCU/Z7682 master_wdt for a reliable BOTH-chip reboot into the new
	# firmware. Guarded, so it is a no-op on boards without the tool; the
	# echo-wdt / reboot-f below remain the fallback.
	# mcu_wdt_arm (static) was copied into $PATH (/tmp/sysupgrade) by stage1 so it
	# survives the rootfs (mtd3) erase; /usr/bin/mcu_wdt_arm is gone by now.
	if command -v mcu_wdt_arm >/dev/null 2>&1; then
		echo "Cinnado S2: arm MCU master_wdt -> both-chip reboot into new firmware"
		mcu_wdt_arm 5
		sleep 10
	fi
	if [ -w /proc/jz/reset/reset ]; then
		echo wdt > /proc/jz/reset/reset
	fi
	sleep 2
	reboot -f
}

[ -z "$1" ] && die "Firmware file is not set."
[ -z "$2" ] && die "Target device is not set."

fw_file="$1"
mtd_dev="/dev/$2"

echo_c 208 "Running Stage 2 of sysupgrade."
echo "Firmware: $fw_file"
echo "Target: $mtd_dev"
echo ""
echo "You can still press Ctrl-C to abort before flashing starts."
echo ""

# Call the detached flash function which will protect the session
detach_and_flash
