+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ATBM6441 / Z7682 MCU hardware-watchdog control over SDIO (MSC1) from U-Boot.
+ *
+ * Register logic ported verbatim from the HW-proven bare-metal blob
+ * (scratchpad/ubootblob/blob.c, cold-boot PASS 2026-07-21). The two only
+ * behavioural substitutions vs the blob are: U-Boot udelay()/mdelay() instead
+ * of the CP0-Count delay, and printf() instead of the raw UART1 pokes.
+ *
+ * There is ZERO conflict with U-Boot's MMC/clk/pinctrl DM: on T23 U-Boot has
+ * no MSC1 node, no MSC1 clock-table entry and no mmc1 pin group, so nothing
+ * else touches MSC1 (0xb3460000), CPM CLKGR0 bit5 / MSC1CDR(0xa4), or the
+ * port-B pins PB8-14. The raw-register bring-up below owns them exclusively.
+ *
+ * Mechanism: the ATBM HERA firmware self-boots from on-chip ROM and is already
+ * streaming WSM TRACE frames at U-Boot time. The WSM credit-gate (STARTUP_IND)
+ * is host-side bookkeeping only, not a wire requirement, so a fire-and-forget
+ * block-write of the command frame to the force-bit input-queue address (0x28)
+ * is accepted by the running firmware, which relays the opcode to the Z7682
+ * MCU.  cmd 0x13 = disable watchdog, cmd 0x12 = enable/re-arm.
+ */
+
+#include <command.h>
+#include <stdio.h>
+#include <linux/delay.h>
+#include <linux/types.h>
+#include <linux/string.h>
+#include <vsprintf.h>
+#include <asm/io.h>
+#include <mach/t23.h>
+#include <atbm_wdt.h>
+
+/* ---- raw 32-bit MMIO (KSEG1 uncached; addresses are already 0xb...) ---- */
+static inline u32 rd(u32 a) { return readl((void __iomem *)(uintptr_t)a); }
+static inline void wr(u32 a, u32 v) { writel(v, (void __iomem *)(uintptr_t)a); }
+
+/* ---- MSC1 controller (0xb3460000, from mach/t23.h) ---- */
+#define MSC1            MSC1_BASE
+#define MR(o)           rd(MSC1 + (o))
+#define MW(o, v)        wr(MSC1 + (o), (v))
+#define MSC_CTRL        0x00
+#define MSC_STAT        0x04
+#define MSC_CLKRT       0x08
+#define MSC_CMDAT       0x0C
+#define MSC_RESTO       0x10
+#define MSC_RDTO        0x14
+#define MSC_BLKLEN      0x18
+#define MSC_NOB         0x1C
+#define MSC_IMASK       0x24
+#define MSC_IFLG        0x28
+#define MSC_CMD         0x2C
+#define MSC_ARG         0x30
+#define MSC_RES         0x34
+#define MSC_RXFIFO      0x38
+#define MSC_TXFIFO      0x3C
+#define MSC_DMAC        0x44
+#define CTRL_CLOCK_START 0x2
+#define CTRL_START_OP   (1 << 2)
+#define CTRL_RESET      (1 << 3)
+#define ST_RESETTING    (1 << 15)
+#define ST_END_CMD_RES  (1 << 11)
+#define ST_DATA_TRAN_DONE (1 << 12)
+#define ST_PRG_DONE     (1 << 13)
+#define ST_CRC_RD_ERR   (1 << 4)
+#define ST_CRC_WR_ERR   (1 << 2)
+#define ST_TIMEOUT_RES  (1 << 1)
+#define ST_FIFO_EMPTY   (1 << 6)
+#define ST_FIFO_FULL    (1 << 7)
+#define DA_BUSY         (1 << 6)
+#define DA_DATA_EN      (1 << 3)
+#define DA_WRITE        (1 << 4)
+#define DA_4BIT         (2 << 9)
+#define RSP_NONE        0
+#define RSP_R1          1
+#define RSP_R3          3
+#define RSP_R6          6
+#define RSP_R5          5
+
+/* ---- CPM / GPIO (mach/t23.h: CPM_BASE 0xb0000000, GPIO_BASE 0xb0010000) ---- */
+#define GPIOB           (GPIO_BASE + 0x1000)   /* 0xb0011000 */
+#define MSC1_PINS       0x6F00u                /* PB8-14 -> MSC1 device fn0 */
+
+static void msc1_clocks_pins(void)
+{
+	/* ungate MSC1 (CLKGR0 bit5); set MSC1 clock divider (24 MHz) */
+	wr(CPM_BASE + CPM_CLKGR0, rd(CPM_BASE + CPM_CLKGR0) & ~CPM_CLKGR0_MSC1);
+	wr(CPM_BASE + CPM_MSC1CDR, 0x18 | MSCCDR_CE);
+	{ int i; for (i = 0; i < 100000 && (rd(CPM_BASE + CPM_MSC1CDR) & MSCCDR_BUSY); i++); }
+	wr(CPM_BASE + CPM_MSC1CDR, 0x18);
+	/* mux PB8-14 to MSC1: INTC/MASKC/PAT1C clear, PAT0S set */
+	wr(GPIOB + 0x18, MSC1_PINS);
+	wr(GPIOB + 0x28, MSC1_PINS);
+	wr(GPIOB + 0x38, MSC1_PINS);
+	wr(GPIOB + 0x44, MSC1_PINS);
+}
+
+static void msc1_reset(void)
+{
+	MW(MSC_CTRL, CTRL_RESET); MW(MSC_CTRL, 0);
+	{ int i; for (i = 0; i < 100000 && (MR(MSC_STAT) & ST_RESETTING); i++); }
+	MW(MSC_CTRL, CTRL_CLOCK_START);
+	MW(MSC_IMASK, 0xffffffff); MW(MSC_IFLG, 0xffffffff);
+	MW(MSC_RDTO, 0xffffff); MW(MSC_DMAC, 0); MW(MSC_RESTO, 0xff); MW(MSC_CLKRT, 6);
+}
+
+static int msc1_cmd(u8 op, u32 arg, u32 rt, u32 *resp)
+{
+	int i; u32 s;
+	MW(MSC_CMD, op); MW(MSC_ARG, arg); MW(MSC_CMDAT, rt); MW(MSC_RESTO, 0xff);
+	MW(MSC_CTRL, CTRL_START_OP);
+	for (i = 0; i < 2000000; i++) {
+		s = MR(MSC_STAT);
+		if (rt == RSP_NONE) break;
+		if (s & ST_TIMEOUT_RES) return -1;
+		if (s & ST_END_CMD_RES) break;
+	}
+	MW(MSC_IFLG, ST_END_CMD_RES);
+	if (resp && rt != RSP_NONE) {
+		u32 a = MR(MSC_RES) & 0xffff, b = MR(MSC_RES) & 0xffff, c = MR(MSC_RES) & 0xffff;
+		*resp = (a << 24) | (b << 8) | (c & 0xff);
+	}
+	return 0;
+}
+
+static int cmd52(int wrf, int func, u32 addr, u8 in, u8 *out)
+{
+	u32 arg = ((u32)(wrf & 1) << 31) | ((u32)(func & 7) << 28) |
+		  ((addr & 0x1FFFF) << 9) | (wrf ? in : 0);
+	u32 r = 0;
+	int e = msc1_cmd(52, arg, RSP_R5, &r);
+	if (out) *out = (u8)(r & 0xff);
+	return e;
+}
+
+/* CMD53 BLOCK-mode func1 R/W, 256B blocks, len must be a multiple of 256. PIO. */
+static int cmd53_block(int wrf, u32 addr, u8 *buf, int len)
+{
+	int i, w, words = len / 4, nblk = len / 256; u32 s;
+	u32 arg = ((u32)(wrf & 1) << 31) | (1u << 28) | (1u << 27) | (1u << 26) |
+		  ((addr & 0x1FFFF) << 9) | ((u32)nblk & 0x1FF);
+	u32 cmdat = RSP_R5 | DA_4BIT | DA_DATA_EN | (wrf ? DA_WRITE : 0);
+	MW(MSC_BLKLEN, 256); MW(MSC_NOB, nblk); MW(MSC_RDTO, 0xffffff);
+	MW(MSC_CMD, 53); MW(MSC_ARG, arg); MW(MSC_CMDAT, cmdat); MW(MSC_RESTO, 0xff);
+	MW(MSC_CTRL, CTRL_START_OP);
+	for (i = 0; i < 2000000; i++) { s = MR(MSC_STAT); if (s & ST_TIMEOUT_RES) return -1; if (s & ST_END_CMD_RES) break; }
+	MW(MSC_IFLG, ST_END_CMD_RES);
+	if (wrf) {
+		for (w = 0; w < words; w++) {
+			u32 v = buf[w*4] | (buf[w*4+1] << 8) | (buf[w*4+2] << 16) | (buf[w*4+3] << 24);
+			for (i = 0; i < 1000000 && (MR(MSC_STAT) & ST_FIFO_FULL); i++);
+			MW(MSC_TXFIFO, v);
+		}
+	} else {
+		for (w = 0; w < words; w++) {
+			u32 v;
+			for (i = 0; i < 1000000 && (MR(MSC_STAT) & ST_FIFO_EMPTY); i++);
+			v = MR(MSC_RXFIFO);
+			buf[w*4] = v & 0xff; buf[w*4+1] = (v >> 8) & 0xff; buf[w*4+2] = (v >> 16) & 0xff; buf[w*4+3] = (v >> 24) & 0xff;
+		}
+	}
+	for (i = 0; i < 2000000; i++) { s = MR(MSC_STAT); if (s & (ST_DATA_TRAN_DONE | ST_PRG_DONE)) break; }
+	MW(MSC_IFLG, ST_DATA_TRAN_DONE | ST_PRG_DONE);
+	return (s & (ST_CRC_RD_ERR | ST_CRC_WR_ERR)) ? -2 : 0;
+}
+
+/* CMD53 byte-mode func1 R/W, incrementing addr, len bytes (<=512). PIO. */
+static int cmd53(int wrf, u32 addr, u8 *buf, int len)
+{
+	int i, w, words = (len + 3) / 4; u32 s;
+	u32 arg = ((u32)(wrf & 1) << 31) | (1u << 28) | (0u << 27) | (1u << 26) |
+		  ((addr & 0x1FFFF) << 9) | ((u32)len & 0x1FF);
+	u32 cmdat = RSP_R5 | DA_4BIT | DA_DATA_EN | (wrf ? DA_WRITE : 0);
+	MW(MSC_BLKLEN, len); MW(MSC_NOB, 1); MW(MSC_RDTO, 0xffffff);
+	MW(MSC_CMD, 53); MW(MSC_ARG, arg); MW(MSC_CMDAT, cmdat); MW(MSC_RESTO, 0xff);
+	MW(MSC_CTRL, CTRL_START_OP);
+	for (i = 0; i < 2000000; i++) { s = MR(MSC_STAT); if (s & ST_TIMEOUT_RES) return -1; if (s & ST_END_CMD_RES) break; }
+	MW(MSC_IFLG, ST_END_CMD_RES);
+	if (wrf) {
+		for (w = 0; w < words; w++) {
+			u32 v = buf[w*4] | (buf[w*4+1] << 8) | (buf[w*4+2] << 16) | (buf[w*4+3] << 24);
+			for (i = 0; i < 1000000 && (MR(MSC_STAT) & ST_FIFO_FULL); i++);
+			MW(MSC_TXFIFO, v);
+		}
+	} else {
+		for (w = 0; w < words; w++) {
+			u32 v;
+			for (i = 0; i < 1000000 && (MR(MSC_STAT) & ST_FIFO_EMPTY); i++);
+			v = MR(MSC_RXFIFO);
+			buf[w*4] = v & 0xff; buf[w*4+1] = (v >> 8) & 0xff; buf[w*4+2] = (v >> 16) & 0xff; buf[w*4+3] = (v >> 24) & 0xff;
+		}
+	}
+	for (i = 0; i < 1000000; i++) { s = MR(MSC_STAT); if (s & (ST_DATA_TRAN_DONE | ST_PRG_DONE)) break; }
+	MW(MSC_IFLG, ST_DATA_TRAN_DONE | ST_PRG_DONE);
+	if (s & (ST_CRC_RD_ERR | ST_CRC_WR_ERR)) return -2;
+	return 0;
+}
+
+/* ---- HIF register file (func1, addr = reg << 2) ---- */
+#define HIF_CONFIG      0x00
+#define HIF_CONTROL     0x04
+#define HIF_QUEUE       0x08
+#define HIF_QUEUE_FORCE 0x28u   /* (buf_id0<<6)|(force1<<5)|reg0x08 : injection TX addr */
+#define HIF_AHB_DPORT   0x0C
+#define HIF_SRAM_BASE   0x10
+#define CFG_ACCESS_MODE (1u << 10)
+#define CFG_CPU_RESET   (1u << 14)
+#define CTL_WUP         (1u << 12)
+
+static u32 hif_r32(u32 a)
+{
+	u8 b[4] = {0, 0, 0, 0};
+	cmd53(0, a, b, 4);
+	return b[0] | (b[1] << 8) | (b[2] << 16) | (b[3] << 24);
+}
+static void hif_w32(u32 a, u32 v)
+{
+	u8 b[4];
+	b[0] = v & 0xff; b[1] = (v >> 8) & 0xff; b[2] = (v >> 16) & 0xff; b[3] = (v >> 24) & 0xff;
+	cmd53(1, a, b, 4);
+}
+static u16 hif_r16(u32 a)
+{
+	u8 b[2] = {0, 0};
+	cmd53(0, a, b, 2);
+	return b[0] | (b[1] << 8);
+}
+static void hif_w16(u32 a, u16 v)
+{
+	u8 b[2];
+	b[0] = v & 0xff; b[1] = (v >> 8) & 0xff;
+	cmd53(1, a, b, 2);
+}
+
+static void px(const char *t, u32 v) { printf("%s0x%08x\n", t, v); }
+
+static int m1_enum(void)
+{
+	u32 r = 0; u16 rca = 0; int i; u8 v = 0;
+	msc1_cmd(0, 0, RSP_NONE, 0); mdelay(2);
+	msc1_cmd(5, 0, RSP_R3, &r);
+	for (i = 0; i < 50; i++) { msc1_cmd(5, r & 0x00300000, RSP_R3, &r); if (r & 0x80000000) break; mdelay(1); }
+	if (!(r & 0x80000000)) { printf("atbm: OCR not ready\n"); return -1; }
+	msc1_cmd(3, 0, RSP_R6, &r); rca = (u16)(r >> 16);
+	msc1_cmd(7, (u32)rca << 16, RSP_R1 | DA_BUSY, &r);
+	MW(MSC_CLKRT, 0);
+	cmd52(0, 0, 0x00, 0, &v);              /* CCCR rev */
+	cmd52(1, 0, 0x07, 0x02, 0);            /* bus width 4-bit */
+	cmd52(1, 0, 0x02, 0x02, 0);            /* IOE func1 */
+	for (i = 0; i < 50; i++) { cmd52(0, 0, 0x03, 0, &v); if (v & 0x02) break; mdelay(1); }
+	cmd52(1, 0, 0x04, 0x03, 0);            /* enable func1 IRQ */
+	cmd52(1, 0, 0x110, 0x00, 0);           /* FBR func1 block size = 256 */
+	cmd52(1, 0, 0x111, 0x01, 0);
+	return (v & 0x02) ? 0 : -2;
+}
+
+/* light wake: only ensure WUP set + message mode (ACCESS_MODE=0). No CPU_RESET. */
+static void wake_light(void)
+{
+	u32 v; u16 c; int i;
+	c = hif_r16(HIF_CONTROL);
+	if (!(c & CTL_WUP)) { c |= CTL_WUP; hif_w16(HIF_CONTROL, c); mdelay(2); }
+	for (i = 0; i < 500 && !(hif_r16(HIF_CONTROL) & 0x2000); i++) udelay(1000); /* CONT_RDY */
+	c = hif_r16(HIF_CONTROL); px("  atbm CONTROL=", c);
+	v = hif_r32(HIF_CONFIG);
+	if (v & CFG_ACCESS_MODE) { v &= ~CFG_ACCESS_MODE; hif_w32(HIF_CONFIG, v); }
+	px("  atbm CONFIG=", hif_r32(HIF_CONFIG));
+}
+
+/*
+ * Build + inject one WSM general-command frame carrying an MCU opcode.
+ *   cmd            = MCU opcode (0x12 enable / 0x13 disable / 0x14 set_period / 0x15 feed)
+ *   payload_word   = little-endian 4-byte argument (only for opcodes that take one)
+ *   payload_len    = argument length in bytes (0 for enable/disable/feed, 4 for set_period)
+ * Frame layout: flag@0, len@4, id@6, magic@8, cmd@12, crc@16, retcode@20,
+ *               payload_len@24, data[512]@28.
+ */
+/* ATBM message_mgr CRC-32: reflected poly 0xEDB88320, init 0xFFFFFFFF, NO final
+ * inversion (=> crc32(empty)=0xFFFFFFFF). Computed over the `paylen` payload bytes. */
+static u32 atbm_crc32(const u8 *p, int n)
+{
+	u32 c = 0xFFFFFFFFu; int i, k;
+	for (i = 0; i < n; i++) {
+		c ^= (u32)p[i];
+		for (k = 0; k < 8; k++)
+			c = (c >> 1) ^ ((c & 1) ? 0xEDB88320u : 0u);
+	}
+	return c;
+}
+
+/*
+ * Build + inject one message_mgr frame (WSM general-cmd 0x003A) carrying an MCU
+ * msg_id + arbitrary payload, with the CORRECT layout the firmware dispatcher
+ * (0xaa954) expects. Message starts at frame offset 8:
+ *   magic@8  msg_id@12  crc32@16  len@20  payload@24
+ * The dispatcher CRC-checks crc32(payload,len) at 0xaa97e and REJECTS a bad CRC,
+ * so a non-empty payload MUST carry the real CRC. (The old m3_frame hardcoded
+ * crc=0xFFFFFFFF and mis-placed len/payload -> only empty payloads ever worked.)
+ */
+/* host->device SDIO write: FORCE bit (bypass the ready-handshake) + cycle buf_id
+ * so each frame lands in a FRESH boot-armed input descriptor. The force path with
+ * a FIXED buf_id 0 only ever delivers ONE frame (2nd = "Rx No Descriptor"); the
+ * device advertised numInpChBufs=24 armed descriptors, so cycling buf_id lets us
+ * send several. tx_seq (3-bit) folded into the WSM id per the driver. */
+static u8 m3_bufid = 0;
+static u8 m3_txseq = 0;
+static void m3_msg(u8 cmd, const u8 *payload, int paylen)
+{
+	static u8 f[768];
+	volatile u32 *fw = (volatile u32 *)f;
+	int i; u32 wid;
+	if (paylen < 0) paylen = 0;
+	if (paylen > 500) paylen = 500;
+	for (i = 0; i < 192; i++) fw[i] = 0;
+	wid = 0x003Au | ((u32)(m3_txseq & 7) << 13);   /* WSM id 0x003A | (seq<<13) */
+	fw[0] = 0x1E00021Cu;                 /* SDIO flag (len 0x021C + carry checksum) */
+	fw[1] = 0x0000021Cu | (wid << 16);   /* WSM len@4 + WSM id@6 */
+	fw[2] = 0xACACCACAu;   /* magic @8 */
+	fw[3] = (u32)cmd;      /* msg_id @12 */
+	fw[5] = (u32)paylen;   /* msg len @20 */
+	for (i = 0; i < paylen; i++) f[24 + i] = payload[i];   /* payload @24 */
+	fw[4] = atbm_crc32(payload, paylen);                   /* crc @16 */
+	/* addr = (buf_id<<6) | force(0x20) | reg0x08 ; HIF_QUEUE_FORCE already = buf0|force|0x08 */
+	cmd53_block(1, ((u32)(m3_bufid & 0x3f) << 6) | HIF_QUEUE_FORCE, f, 768);
+	m3_bufid = (u8)((m3_bufid + 1) & 0x3f);
+	m3_txseq = (u8)((m3_txseq + 1) & 7);
+}
+
+/* thin wrapper: 0- or 4-byte LE word payload (existing wdt/etc. opcodes). */
+static void m3_frame(u8 cmd, u32 payload_word, int payload_len)
+{
+	u8 pl[4];
+	pl[0] = payload_word & 0xff; pl[1] = (payload_word >> 8) & 0xff;
+	pl[2] = (payload_word >> 16) & 0xff; pl[3] = (payload_word >> 24) & 0xff;
+	m3_msg(cmd, pl, payload_len);
+}
+
+/* MCU watchdog opcodes (from mcu_test/lpmgr reverse). */
+#define MCU_WDT_ENABLE     0x12   /* no arg; enables the WDT block (does NOT set the period) */
+#define MCU_WDT_DISABLE    0x13   /* no arg */
+#define MCU_WDT_SET_PERIOD 0x14   /* 4-byte LE seconds; THIS starts the countdown-to-reset */
+#define MCU_WDT_PERIOD_S   12     /* vendor lpmgr uses 12 s (fed every 6 s) */
+#define MCU_SET_MASTER_MODE 0x2b   /* arg=0 halts STA scan/reconnect (the ~56s scan-crash fix, LIVE-verified) */
+
+/*
+ * host RX (device->host) output-ring drain. Reading a COMPLETED output frame is
+ * what makes the fw run its output-completion handler (c49bc), whose sole job is
+ * to re-arm input descriptors (c4788). THAT is the credit-recovery that lets the
+ * host issue MORE than the ~24 boot-armed frames: a fire-and-forget write with no
+ * reply never completes an output, so credits bleed to 0 at ~24; every drained
+ * reply hands one input credit back.
+ *
+ * Faithful to the vendor driver (bh_sdio.c atbm_sdio_process_read_data +
+ * hwio_sdio.c atbm_data_read_unlock):
+ *   - read CONTROL(reg1) NEXT_LEN = ((c&0x0FFF)|((c&0xC000)>>2))*2
+ *   - size-validate (>= wsm_hdr(4), <= EFFECTIVE_BUF_SIZE) BEFORE reading
+ *   - CMD53-read alloc=roundup(len+2,256) from the IN_OUT queue (reg2=0x08)
+ *   - read buf_id MUST be a PERSISTENT counter cycling 1,2,3,4 across the whole
+ *     session (driver hw_priv->buf_id_rx = (buf_id_rx+1)&3, addr uses buf_id_rx+1);
+ *     resetting it per call (the old bug) desyncs the HIF and crashes it at ~5.
+ *   - take the piggybacked next-len from the last 2 bytes of each read; loop.
+ * Returns #frames drained; if want_id!=0, *rc gets that msg's retcode (word@16).
+ */
+static u8 m3_bufrx = 0;   /* persistent; reset only in atbm_link_up() */
+
+static int atbm_rx_drain(u16 want_id, s32 *rc, int max_frames, int verbose)
+{
+	static u8 b[2048];
+	u16 ctrl, id; u32 nl, alloc; int n = 0, k;
+	if (rc) *rc = -1;
+	ctrl = hif_r16(HIF_CONTROL);
+	nl = ((u32)(ctrl & 0x0FFF) | ((u32)(ctrl & 0xC000) >> 2)) * 2;
+	while (nl && n < max_frames) {
+		if (nl < 4 || nl > 1600) break;           /* driver validity guard */
+		alloc = (nl + 2 + 255) & ~255u;           /* +piggyback, round to 256 */
+		if (alloc > sizeof(b)) break;
+		if (cmd53_block(0, ((u32)((m3_bufrx & 3) + 1) << 6) | HIF_QUEUE, b, alloc))
+			break;
+		m3_bufrx = (u8)((m3_bufrx + 1) & 3);      /* persistent cycle 0..3 */
+		id = (u16)((b[2] | (b[3] << 8)) & 0x0FFF);
+		ctrl = (u16)(b[alloc-2] | (b[alloc-1] << 8));   /* piggyback next-len */
+		nl = ((u32)(ctrl & 0x0FFF) | ((u32)(ctrl & 0xC000) >> 2)) * 2;
+		n++;
+		if (verbose) {
+			printf("  atbm rx[%d] id=0x%04x:", n, id);
+			for (k = 0; k < 24; k++) printf(" %02x", b[k]);
+			printf("\n");
+		}
+		if (want_id && id == want_id && rc)
+			*rc = (s32)(b[16] | (b[17]<<8) | (b[18]<<16) | (b[19]<<24));
+	}
+	return n;
+}
+
+/* Wait briefly for a reply then drain, reporting the 0x043A confirm retcode. */
+static int m3_read_confirm(void)
+{
+	s32 rc = -1; int n, i;
+	for (i = 0; i < 800; i++) { if (hif_r16(HIF_CONTROL) & 0xCFFF) break; udelay(1000); }
+	n = atbm_rx_drain(0x043A, &rc, 16, 1);
+	if (n == 0) { printf("  atbm: no reply frame (fire-and-forget)\n"); return -1; }
+	printf("  atbm: drained %d frame(s); 0x043A retcode=%d\n", n, rc);
+	return rc;
+}
+
+/* Bring MSC1/SDIO up + wake the ATBM into message mode. 0 on success. */
+static int atbm_link_up(void)
+{
+	int e;
+	msc1_clocks_pins();
+	msc1_reset();
+	e = m1_enum();
+	if (e) { printf("atbm: SDIO enum failed (%d)\n", e); return e; }
+	wake_light();
+	m3_bufid = 0; m3_txseq = 0; m3_bufrx = 0;   /* fresh session buf-id counters */
+	return 0;
+}
+
+/* Link-state so console-entry's single link-up can be reused by later
+ * `atbm wsm` commands (a 2nd atbm_link_up() would CMD0 the live card = fatal). */
+static int atbm_linked = 0;
+static int atbm_ensure_linked(void)
+{
+	if (atbm_linked) return 0;
+	if (atbm_link_up()) return -1;
+	atbm_linked = 1;
+	return 0;
+}
+
+/*
+ * Build + inject one RAW WSM command frame (arbitrary id + payload). This is the
+ * SAME SDIO/WSM transport as the 0x003A general-cmd (proven working), so it
+ * reaches the ATBM WiFi firmware's WSM dispatcher directly.
+ * Header is 8 bytes: flag@0, len@4, id@6; payload@8. len = 8 + paylen.
+ * flag = len | (len-checksum << 24)  (matches driver bh_sdio.c). SDIO transfer
+ * is block-rounded to 256. Used to find the stop-scan command, e.g.:
+ *   0x000D wifimode        payload 00 00 00 00 01 00 00 00  (is_ap=1)
+ *   0x0036 auto_reconnect  payload 00 00 00 00 00 00 00 00  (disable)
+ *   0x002C clear_wifi_cfg / 0x0026 fw_sleep  payload 00 00 00 00
+ */
+static void m3_wsm_raw(u16 id, const u8 *payload, int paylen)
+{
+	static u8 f[768];
+	int i, txlen, total, lo, hi, sum, chk;
+	for (i = 0; i < 768; i++) f[i] = 0;
+	txlen = 8 + paylen;
+	lo = txlen & 0xff; hi = (txlen >> 8) & 0xff; sum = lo + hi;
+	chk = (sum & 0x100) ? ((sum + 1) & 0xff) : (sum & 0xff);
+	f[0] = (u8)lo; f[1] = (u8)hi; f[2] = 0; f[3] = (u8)chk;   /* flag */
+	f[4] = (u8)lo; f[5] = (u8)hi;                              /* len  */
+	f[6] = (u8)(id & 0xff); f[7] = (u8)((id >> 8) & 0xff);     /* id   */
+	for (i = 0; i < paylen && i < 512; i++) f[8 + i] = payload[i];
+	total = txlen; if (total < 16) total = 16;
+	if (total % 256) { total -= (total % 256); total += 256; }
+	if (total > 768) total = 768;
+	cmd53_block(1, HIF_QUEUE_FORCE, f, total);
+}
+
+/*
+ * Fire one raw MCU opcode (+ optional 4-byte LE arg) and report the confirm.
+ * Used by the `atbm mcu` probe command. Each call re-establishes the SDIO
+ * link, so it also acts as a host-alive keepalive "feed".
+ */
+int atbm_mcu_cmd(u8 cmd, u32 arg, int arglen)
+{
+	int rc;
+	if (atbm_ensure_linked()) return -1;
+	m3_frame(cmd, arg, arglen);
+	mdelay(5);
+	rc = m3_read_confirm();
+	printf("atbm: mcu cmd=0x%x arg=0x%x len=%d -> retcode=%d\n", cmd, arg, arglen, rc);
+	return rc;
+}
+
+int atbm_wdt_set(int enable)
+{
+	int rc;
+
+	enable = !!enable;
+	/* No last_state cache: every call re-does the SDIO enum + WSM send, so a
+	 * repeated 'atbm wdt off' also serves as a host-alive keepalive feed. */
+	if (atbm_link_up()) { printf("atbm: MCU wdt NOT changed\n"); return -1; }
+	if (enable) {
+		/* Enable alone only powers the WDT block; SET_PERIOD arms the
+		 * countdown-to-reset. Mirror the vendor: enable then set_period. */
+		m3_frame(MCU_WDT_ENABLE, 0, 0);
+		mdelay(2);
+		m3_frame(MCU_WDT_SET_PERIOD, MCU_WDT_PERIOD_S, 4);
+	} else {
+		m3_frame(MCU_WDT_DISABLE, 0, 0);
+	}
+	mdelay(5);
+	rc = m3_read_confirm();
+	printf("atbm: MCU watchdog %s (0x%x) -> retcode=%d %s\n",
+	       enable ? "ENABLE+arm" : "DISABLE",
+	       enable ? MCU_WDT_ENABLE : MCU_WDT_DISABLE, rc,
+	       rc == 0 ? "OK (confirmed)" :
+	       rc > 0  ? "(MCU error code)" :
+	                 "(sent, no confirm - fire-and-forget usually still applies)");
+	return 0;
+}
+
+/*
+ * Called from main_loop() right before the interactive CLI is entered
+ * (autoboot interrupted, or bootcmd returned). Kill the MCU watchdog so the
+ * ~14.5 s reset cannot fire while the operator works at the U-Boot prompt.
+ */
+void atbm_wdt_console_entry(void)
+{
+	printf("atbm: recovery console -> MCU wdt off + stop WiFi scan (start_ap)\n");
+	/* Two force-bit injects to CYCLED buf_ids (0,1) -> two fresh input descriptors:
+	 *   0x13 = MCU watchdog disable (kills the ~14s MCU-wdt reset).
+	 *   0x40 = wifi_start_ap "s2": flips the scanning STA vif to AP so the reconnect
+	 *          tick stops (no LMACtoUMAC_ScanComplete assert -> no ~26-40s scan-crash).
+	 * LIVE-verified: 0x40 reaches the MCU (message_mgr wifi_start_ap:s2 -> bcreate_ap
+	 * ssid:s2). Both must land or the un-killed reset still fires. */
+	if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return; }
+	m3_frame(MCU_WDT_DISABLE, 0, 0);       /* buf_id0: wdt off */
+	mdelay(5);
+	m3_msg(0x40, (const u8 *)"s2", 2);     /* buf_id1: start_ap -> stop scan */
+	mdelay(30);
+	(void)m3_read_confirm();
+	printf("atbm: MCU wdt off + start_ap(s2). Idle U-Boot should be crash-proof.\n");
+}
+
+/* Cycling raw-WSM sender for PLANE-A (WiFi-MAC) commands. Like m3_wsm_raw but
+ * cycles buf_id + folds tx_seq, so a multi-frame AP bring-up doesn't starve the
+ * boot-armed input ring (same fix as m3_msg). Frame = {flag@0, len@4, id@6,
+ * payload@8}; len = 8 + paylen; id carries the 3-bit tx_seq in bits 13..15. */
+static void wsm_send_raw(u16 id, const u8 *pl, int paylen)
+{
+	static u8 f[768];
+	int i, txlen, total, lo, hi, sum, chk; u16 wid;
+	if (paylen < 0) paylen = 0;
+	if (paylen > 600) paylen = 600;
+	for (i = 0; i < 768; i++) f[i] = 0;
+	txlen = 8 + paylen;
+	lo = txlen & 0xff; hi = (txlen >> 8) & 0xff; sum = lo + hi;
+	chk = (sum & 0x100) ? ((sum + 1) & 0xff) : (sum & 0xff);
+	wid = (u16)((id & 0x1FFF) | ((u16)(m3_txseq & 7) << 13));
+	f[0] = (u8)lo; f[1] = (u8)hi; f[2] = 0; f[3] = (u8)chk;
+	f[4] = (u8)lo; f[5] = (u8)hi;
+	f[6] = (u8)(wid & 0xff); f[7] = (u8)((wid >> 8) & 0xff);
+	for (i = 0; i < paylen; i++) f[8 + i] = pl[i];
+	total = txlen; if (total < 256) total = 256;
+	if (total % 256) { total -= (total % 256); total += 256; }
+	if (total > 768) total = 768;
+	cmd53_block(1, ((u32)(m3_bufid & 0x3f) << 6) | HIF_QUEUE_FORCE, f, total);
+	m3_bufid = (u8)((m3_bufid + 1) & 0x3f);
+	m3_txseq = (u8)((m3_txseq + 1) & 7);
+}
+
+/* ---- AHB windowed read: host reads an ATBM AHB peripheral reg over SDIO ----
+ * Recipe = vendor driver atbm_indirect_read (hwio_sdio.c): write SRAM_BASE=addr,
+ * set CONFIG AHB_PFETCH (bit11), poll until it self-clears, read AHB_DPORT. Uses
+ * the existing func1 helpers (SRAM_BASE=reg4=0x10, AHB_DPORT=reg3=0x0C). */
+#define CFG_AHB_PFETCH   (1u << 11)
+static u32 atbm_ahb_r32(u32 ahb_addr)
+{
+	u32 orig, cfg, data; int i;
+	/* Vendor atbm_direct_read_reg_32: must switch the HIF to REGISTER mode
+	 * (CONFIG ACCESS_MODE=bit10) around the indirect read, else in message mode
+	 * the windowed read never engages and returns stale queue bytes. Restore after. */
+	orig = hif_r32(HIF_CONFIG);
+	hif_w32(HIF_CONFIG, orig | CFG_ACCESS_MODE);
+	hif_w32(HIF_SRAM_BASE, ahb_addr);
+	cfg = hif_r32(HIF_CONFIG);
+	hif_w32(HIF_CONFIG, cfg | CFG_AHB_PFETCH);
+	for (i = 0; i < 20 && (hif_r32(HIF_CONFIG) & CFG_AHB_PFETCH); i++) mdelay(1);
+	data = hif_r32(HIF_AHB_DPORT);
+	hif_w32(HIF_CONFIG, orig);   /* back to message mode for the WSM plane */
+	return data;
+}
+
+/* RST button = ATBM GPIO 0x16800020 bit17, active-LOW (0 = pressed). LIVE-verified
+ * (AT-console: bit17 1<->0 tracks release<->press). The POWER button is a separate
+ * MCU input (6s hold = autonomous power on/off), NOT this bit. */
+#define ATBM_GPIO_INPUT  0x16800020u
+#define ATBM_KEY0_BIT    17
+static int atbm_rst_pressed(void)
+{
+	u32 v = atbm_ahb_r32(ATBM_GPIO_INPUT);
+	return ((v >> ATBM_KEY0_BIT) & 1) ? 0 : 1;
+}
+
+/* ---- status LED (T23 GPIO49 = port B pin 17), JZ GPIO regs @ GPIOB=0xb0011000:
+ * config output = INTC(0x18)+MASKS(0x24 gpio-mode)+PAT1C(0x38 output);
+ * level = PAT0S(0x44) high / PAT0C(0x48) low. LED assumed active-high. ---- */
+#define LED_STATUS   (1u << 17)   /* gpio49 = PB17 */
+static void led_cfg(void) { wr(GPIOB + 0x18, LED_STATUS); wr(GPIOB + 0x24, LED_STATUS); wr(GPIOB + 0x38, LED_STATUS); }
+static void led(int on)   { wr(GPIOB + (on ? 0x44 : 0x48), LED_STATUS); }
+
+/*
+ * Boot-time RST recovery gesture (called from board_late_init, before autoboot).
+ * If the RST button (ATBM GPIO 0x16800020 bit17, active-low) is HELD at power-on,
+ * blink the status LED while counting; hold 10 s -> FACTORY RESET via the chunked
+ * `overlay_wipe` env (sf-erase the overlay/data region + reset). Release before
+ * 10 s -> normal boot. Reading RST needs the ATBM SDIO link; if it can't come up,
+ * or RST isn't held, we return immediately (normal boot, MCU wdt untouched).
+ * UNTESTED ON HARDWARE 2026-07-27: verify LED pin/polarity + the 10 s reset path.
+ */
+void atbm_rst_recovery_check(void)
+{
+	int held = 0, on = 0, period;
+	if (atbm_ensure_linked()) return;          /* SDIO down -> normal boot */
+	if (!atbm_rst_pressed()) return;           /* RST not held -> normal boot */
+	printf("\natbm: RST held at boot -> keep holding 10s for FACTORY RESET (release to cancel)\n");
+	atbm_wdt_set(0);                           /* kill the ~14.5s MCU wdt for the window */
+	led_cfg();
+	while (atbm_rst_pressed()) {
+		period = (held < 5000) ? 400 : (held < 8000) ? 200 : 100;  /* blink faster near 10s */
+		led(on ^= 1);
+		mdelay(period);
+		held += period;
+		if ((held % 1000) < period) printf("  atbm: RST held %ds ...\n", held / 1000);
+		if (held >= 10000) {
+			printf("atbm: 10s -> FACTORY RESET: overlay wipe (chunked) + reboot\n");
+			led(1);
+			run_command("run overlay_wipe", 0);   /* chunked sf erase + reset */
+			return;                               /* overlay_wipe resets; not reached */
+		}
+	}
+	led(0);
+	printf("atbm: RST released before 10s -> normal boot\n");
+}
+
+#if defined(CONFIG_CMD_ATBM)
+static int do_atbm(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	if (argc >= 3 && !strcmp(argv[1], "wdt")) {
+		int enable;
+		if (!strcmp(argv[2], "off") || !strcmp(argv[2], "disable"))
+			enable = 0;
+		else if (!strcmp(argv[2], "on") || !strcmp(argv[2], "enable"))
+			enable = 1;
+		else
+			return CMD_RET_USAGE;
+		return atbm_wdt_set(enable) ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+	}
+
+	/* atbm mcu <cmd_hex> [arg_hex] : fire any raw MCU opcode + show confirm.
+	 * With arg -> 4-byte LE payload (set_period etc.). For probing host-alive. */
+	if (argc >= 3 && !strcmp(argv[1], "mcu")) {
+		u8 cmd = (u8)simple_strtoul(argv[2], NULL, 16);
+		u32 arg = 0; int arglen = 0;
+		if (argc >= 4) { arg = simple_strtoul(argv[3], NULL, 16); arglen = 4; }
+		atbm_mcu_cmd(cmd, arg, arglen);
+		return CMD_RET_SUCCESS;
+	}
+
+	/* atbm wsm <id_hex> [byte_hex ...] : inject a RAW WSM command (id + payload)
+	 * over the SAME transport as the MCU general-cmd. Reuses the console-entry
+	 * SDIO link (no fatal re-link). For finding the stop-scan command:
+	 *   atbm wsm d  00 00 00 00 01 00 00 00   wifimode is_ap=1 (STA->AP)
+	 *   atbm wsm 36 00 00 00 00 00 00 00 00   auto_reconnect disable
+	 *   atbm wsm 2c 00 00 00 00               clear_wifi_config
+	 *   atbm wsm 26 00 00 00 00               fw_sleep */
+	if (argc >= 3 && !strcmp(argv[1], "wsm")) {
+		u16 id = (u16)simple_strtoul(argv[2], NULL, 16);
+		u8 pl[64]; int n = 0, i;
+		for (i = 3; i < argc && n < (int)sizeof(pl); i++)
+			pl[n++] = (u8)simple_strtoul(argv[i], NULL, 16);
+		if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return CMD_RET_FAILURE; }
+		printf("atbm: inject WSM id=0x%04x paylen=%d\n", id, n);
+		m3_wsm_raw(id, pl, n);
+		mdelay(20);
+		return CMD_RET_SUCCESS;
+	}
+
+	/* atbm apA <ssid> [ch] : bring up the OPEN AP the VENDOR way (plane-A softMAC),
+	 * so the HOST becomes the 802.11 endpoint that receives client DATA as 0x0804.
+	 * Sequence = atbm_softap.c: CLEAR_WIFI_CFG(0x2C) -> WIFI_MODE(0x0D is_ap=1) ->
+	 * AP_CFG(0x0E, wsm_ap_cfg_req{status,u32; wsm_join{flags,bssid[6],ssidLen,ssid[32],
+	 * keyMgmt=0 open,...}}). Then drain to see confirms (0x040D/0x040E) + client 0x0804. */
+	if (argc >= 3 && !strcmp(argv[1], "apA")) {
+		const char *ssid = argv[2];
+		int ch = (argc >= 4) ? (int)simple_strtoul(argv[3], NULL, 10) : 6;
+		int n = (int)strlen(ssid), i; static u8 wm[8], ap[112]; u8 z4[4];
+		if (n > 32) n = 32; if (n < 1) n = 1;
+		if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return CMD_RET_FAILURE; }
+		printf("atbm apA: plane-A OPEN AP ssid='%s' ch=%d\n", ssid, ch);
+		z4[0]=z4[1]=z4[2]=z4[3]=0;
+		wsm_send_raw(0x002C, z4, 4);                 /* CLEAR_WIFI_CFG */
+		mdelay(15); (void)atbm_rx_drain(0, NULL, 8, 0);
+		for (i=0;i<8;i++) wm[i]=0;                    /* wsm_wifi_set_req */
+		wm[4]=1; wm[5]=(u8)ch; wm[6]=2;              /* is_ap=1, channel, countryId=2 */
+		wsm_send_raw(0x000D, wm, 8);                  /* WIFI_MODE = AP */
+		mdelay(15); (void)atbm_rx_drain(0, NULL, 8, 0);
+		for (i=0;i<112;i++) ap[i]=0;                  /* wsm_ap_cfg_req: status@0..3=0 */
+		ap[11]=(u8)n;                                 /* join.ssidLength @ 4+7 */
+		for (i=0;i<n;i++) ap[12+i]=(u8)ssid[i];       /* join.ssid @ 4+8 */
+		ap[44]=0;                                     /* join.keyMgmt @ 4+40 = OPEN */
+		wsm_send_raw(0x000E, ap, 112);                /* AP_CFG */
+		mdelay(30); (void)atbm_rx_drain(0, NULL, 12, 1);
+		printf("atbm apA: CLEAR+WIFIMODE+AP_CFG sent; run 'atbm rx' while a client joins\n");
+		return CMD_RET_SUCCESS;
+	}
+
+	/* atbm ahb <addr> : read an ATBM AHB register over SDIO (host AHB window).
+	 * Sanity: `atbm ahb 16600000` should read 0x03002001 (WDT base, matches AT+rmem). */
+	if (argc >= 3 && !strcmp(argv[1], "ahb")) {
+		u32 a = simple_strtoul(argv[2], NULL, 16);
+		if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return CMD_RET_FAILURE; }
+		printf("atbm ahb 0x%08x = 0x%08x\n", a, atbm_ahb_r32(a));
+		return CMD_RET_SUCCESS;
+	}
+
+	/* atbm button [n] : read the RST button (ATBM GPIO 0x16800020 bit17, active-low)
+	 * via the SDIO AHB window. With n>1, poll n times @200ms to watch it toggle. */
+	if (argc >= 2 && !strcmp(argv[1], "button")) {
+		int n = (argc >= 3) ? (int)simple_strtoul(argv[2], NULL, 10) : 1;
+		int i;
+		if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return CMD_RET_FAILURE; }
+		for (i = 0; i < n; i++) {
+			u32 v = atbm_ahb_r32(ATBM_GPIO_INPUT);
+			printf("atbm RST: %s  (0x16800020=0x%08x bit17=%d)\n",
+			       ((v >> ATBM_KEY0_BIT) & 1) ? "released" : "*** PRESSED ***",
+			       v, (int)((v >> ATBM_KEY0_BIT) & 1));
+			if (n > 1) mdelay(200);
+		}
+		/* bare `atbm button` -> exit code from state (for `if atbm button`) */
+		if (n == 1) return atbm_rst_pressed() ? CMD_RET_SUCCESS : CMD_RET_FAILURE;
+		return CMD_RET_SUCCESS;
+	}
+
+	/* atbm ap <ssid> : plane-B msg_id 0x40 (wifi_start_ap) with SSID payload + real
+	 * CRC-32. Switches ATBM STA->AP (deauths STA) -> stops the boot scan/reconnect
+	 * loop (the ~56s scan-crash). SSID 1..32 chars. */
+	/* atbm ping [n] : the FULL-HANDSHAKE proof. Send a reply-eliciting cmd (0x13
+	 * wdt-disable -> 0x043A confirm) n times, DRAINING each reply. If the drain
+	 * correctly recovers input credits, all n confirm even for n>24 (the old
+	 * fire-and-forget bound). Prints running credit count from the confirms. */
+	if (argc >= 2 && !strcmp(argv[1], "ping")) {
+		int n = (argc >= 3) ? (int)simple_strtoul(argv[2], NULL, 10) : 40;
+		int ok = 0, i; s32 rc;
+		if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return CMD_RET_FAILURE; }
+		for (i = 0; i < n; i++) {
+			m3_frame(MCU_WDT_DISABLE, 0, 0);
+			mdelay(3);
+			if (atbm_rx_drain(0x043A, &rc, 8, 0) > 0 && rc == 0) ok++;
+			if (((i + 1) % 8) == 0) printf("  atbm ping: %d/%d confirmed\n", ok, i + 1);
+		}
+		printf("atbm ping DONE: %d/%d confirmed -> credit-recovery %s\n",
+		       ok, n, (ok > 24) ? "WORKS (>24)" : "INSUFFICIENT");
+		return CMD_RET_SUCCESS;
+	}
+
+	/* atbm rx : one-shot drain of pending device->host frames (verbose). */
+	if (argc >= 2 && !strcmp(argv[1], "rx")) {
+		int n;
+		if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return CMD_RET_FAILURE; }
+		n = atbm_rx_drain(0, NULL, 16, 1);
+		printf("atbm rx: drained %d frame(s)\n", n);
+		return CMD_RET_SUCCESS;
+	}
+
+	if (argc >= 3 && !strcmp(argv[1], "ap")) {
+		const char *ssid = argv[2];
+		int n = (int)strlen(ssid);
+		if (n < 1) n = 1;
+		if (n > 32) n = 32;
+		if (atbm_ensure_linked()) { printf("atbm: link-up failed\n"); return CMD_RET_FAILURE; }
+		printf("atbm: start_ap (0x40) ssid='%s' len=%d\n", ssid, n);
+		m3_msg(0x40, (const u8 *)ssid, n);
+		mdelay(20);
+		(void)m3_read_confirm();
+		return CMD_RET_SUCCESS;
+	}
+
+	return CMD_RET_USAGE;
+}
+
+U_BOOT_CMD(atbm, 16, 0, do_atbm,
+	"ATBM6441 / Z7682 MCU control",
+	"wdt on|off        - enable(0x12+0x14)/disable(0x13) the Z7682 MCU watchdog\n"
+	"atbm mcu <c> [a]  - fire raw MCU opcode c (hex) with optional 4B arg a (hex)\n"
+	"atbm wsm <id> [b..] - inject raw WSM cmd id (hex) + payload bytes (hex)\n"
+	"atbm ping [n]     - send 0x13 n times + drain replies (full-handshake proof)\n"
+	"atbm rx           - drain pending device->host frames\n"
+	"atbm ahb <addr>   - read an ATBM AHB register (hex) over SDIO\n"
+	"atbm button [n]   - read RST button (GPIO 0x16800020 bit17, active-low)\n"
+	"atbm apA <ssid>   - bring up OPEN AP the vendor plane-A way (host gets 0x0804 data)");
+#endif /* CONFIG_CMD_ATBM */
