diff --git a/include/atbm_wdt.h b/include/atbm_wdt.h
new file mode 100755
index 0000000..3b62866
--- /dev/null
+++ b/include/atbm_wdt.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * ATBM6441 / Z7682 MCU hardware-watchdog control from U-Boot.
+ *
+ * Brings up MSC1 SDIO, enumerates the ATBM6441 SDIO func1, light-wakes the
+ * resident HERA WiFi firmware (self-booted from ROM, already alive at U-Boot
+ * time) and injects one WSM general-command (id 0x003A) carrying the MCU
+ * opcode that enables (0x12) or disables (0x13) the on-package Z7682
+ * hardware watchdog. Without a disable, the board resets ~14.5 s after boot.
+ *
+ * HW-proven on a cold boot 2026-07-21 (board survived >20 s after inject).
+ */
+#ifndef __ISVP_T23_ATBM_WDT_H__
+#define __ISVP_T23_ATBM_WDT_H__
+
+/*
+ * enable != 0 -> MCU opcode 0x12 (re-arm watchdog)
+ * enable == 0 -> MCU opcode 0x13 (disable watchdog)
+ * Returns 0 on success (SDIO enumerated + command injected), < 0 on failure.
+ * Prints one clear status line on success and on failure. Skips a redundant
+ * inject if the watchdog is already in the requested state.
+ */
+int atbm_wdt_set(int enable);
+
+/*
+ * Convenience hook for main_loop(): logs a context line and disables the MCU
+ * watchdog when U-Boot drops to the interactive console (autoboot interrupted).
+ */
+void atbm_wdt_console_entry(void);
+
+#endif /* __ISVP_T23_ATBM_WDT_H__ */
