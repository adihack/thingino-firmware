#!/bin/sh

echo -c 196 -e "\n\nGoing to reboot!\n"

# Cinnado S2 reliable reboot. A T23-only warm reboot HANGS and leaves the ATBM
# WiFi core stale (WiFi never comes back; even the HW watchdog does not recover
# the board). The reliable fix is to reboot BOTH chips via the ATBM/Z7682
# master_wdt: arming it makes the MCU's master-power state machine power-cycle
# the whole board (master_wdt_timer_cb -> master_power_off -> "reboot two
# devices" -> HI_SDIO_Host_Reboot). This is STATE-INDEPENDENT (the Z7682 is a
# separate always-on core), unlike the driver's AHB SMU poke, which stops
# landing once the ATBM WiFi core has aged into low-power. The MCU only needs the
# SDIO/WSM link at ARM time, then fires autonomously - so nothing after this can
# stop it. sync first so the overlay (jffs2) is flushed before the reset.
sync
if [ -x /usr/bin/mcu_wdt_arm ]; then
	echo -c 15 "Cinnado S2: arm MCU master_wdt -> both-chip cold boot"
	mcu_wdt_arm 5
	sleep 15   # the MCU reboots both chips in ~5 s; fall through only if it did not
fi

# ---- Fallback (master_wdt did not fire): orderly shutdown + reboot -f + HW wdt ----
# Run init scripts in the desired order: F, K, S with reversed numerical order within each group.
# Skip K99watchdog so the hardware watchdog stays armed as a last-resort fallback.
for letter in F K S; do
	for i in $(find /etc/init.d/ -name "${letter}*" -executable | grep -v 'K99watchdog' | sort -r); do
		/bin/sh -c "$i stop"
	done
done

sync

# Kill watchdog with SIGKILL so it cannot disarm the hardware watchdog.
WD_PID=$(cat /var/run/watchdog.pid 2>/dev/null)
[ -n "$WD_PID" ] && kill -9 "$WD_PID" 2>/dev/null
killall -9 watchdog 2>/dev/null || true

reboot -f 2>/dev/null || echo b >/proc/sysrq-trigger 2>/dev/null

exit 0
