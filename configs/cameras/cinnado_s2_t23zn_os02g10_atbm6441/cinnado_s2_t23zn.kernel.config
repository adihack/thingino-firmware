# Kernel config fragment for Cinnado S2 (T23ZN / OS02G10 / ATBM6441).
#
# S2 builds its ATBM6441 driver from source (wifi-atbm6441 -> atbm6441_wifi_sdio.ko); the 6441
# chip shares the same Z7682 MCU/librtos interface as the 6461. These options mirror the ZRT profile.

# Required for atbm6441_wifi_sdio.ko symbol resolution.
# warn_slowpath_fmt / warn_slowpath_null are inside #ifdef CONFIG_BUG in kernel/panic.c.
CONFIG_BUG=y

# print_hex_dump_bytes is inside #if !defined(CONFIG_DYNAMIC_DEBUG) in lib/hexdump.c --
# with DYNAMIC_DEBUG=y the symbol is compiled out.
# CONFIG_DYNAMIC_DEBUG is not set

# MMC1 (SDIO to the ATBM) fixups (jzmmc_manual_detect) are provided by wifi-atbm6461.mk.

# Reboot fix (2026-07-28): the default WDT soft-reset (jz_wdt_restart) HANGS on this board
# (a WDT reset does not re-cycle the SPI-NOR/ATBM state so the bootrom cannot reload TPL).
# Enable the RTC hibernate/full-power-cycle reset for machine_restart so 'reboot' actually
# restarts (live-verified: hibernate reset reboots cleanly where WDT hangs). See reset.c.
CONFIG_HIBERNATE_RESET=y
