# Kernel config fragment for Cinnado S2 (T23ZN / OS02G10 / ATBM6441).
#
# S2 runs the thingino ATBM6461 stack (atbm6461_wifi_sdio.ko); the 6441 chip shares the
# same Z7682 MCU/librtos interface. These options mirror the Cinnado B6 / Wansview A1 ZRT profile.

# Required for atbm6461_wifi_sdio.ko symbol resolution.
# warn_slowpath_fmt / warn_slowpath_null are inside #ifdef CONFIG_BUG in kernel/panic.c.
CONFIG_BUG=y

# print_hex_dump_bytes is inside #if !defined(CONFIG_DYNAMIC_DEBUG) in lib/hexdump.c --
# with DYNAMIC_DEBUG=y the symbol is compiled out.
# CONFIG_DYNAMIC_DEBUG is not set

# MMC1 (SDIO to the ATBM) fixups (jzmmc_manual_detect) are provided by wifi-atbm6461.mk.
