# Cinnado S2 (T23ZN + ATBM6441): Z7682 MCU hardware-watchdog control from U-Boot.
# Enables 'atbm wdt on|off', the console-entry auto-disable hook (autoboot
# interrupted -> kill the ~14.5s MCU wdt), and the board_late_init WDT_DISABLE
# env-flag hook. Implementation: board/ingenic/isvp-t23/atbm_wdt.c.
CONFIG_CMD_ATBM=y
CONFIG_BOARD_LATE_INIT=y
